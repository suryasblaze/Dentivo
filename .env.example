# ---------- frontend (Vite) ----------
# Short bill links. Without these the bill travels inside the link instead.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Where the React app finds the API. Empty means same origin (/api/...).
VITE_API_URL=

# ---------- backend (Flask) ----------
# Supabase → Project Settings → Database → Connection string → URI.
# Use the pooled connection (port 6543) when running serverless.
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres
# Long random string used to sign login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Hours a login lasts
JWT_HOURS=720
# Comma-separated sites allowed to call the API
CORS_ORIGINS=http://localhost:5173
